<UserControl x:Class="Saradomin.View.Controls.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:gl="using:System.Globalization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Saradomin.View.Controls"
             xmlns:mvvm="clr-namespace:Glitonea.Mvvm;assembly=Glitonea"
             xmlns:vm="clr-namespace:Saradomin.ViewModel.Controls"
             DataContext="{mvvm:DataContextSource vm:SettingsViewModel}">
    <Grid Margin="0,0,2,2"
          ColumnDefinitions="0.55*,*">

        <!-- LEFT -->
        <DockPanel Grid.Column="0">
            <HeaderedContentControl Classes="GroupBox"
                                    DockPanel.Dock="Top"
                                    Header="launcher settings">
                <StackPanel Orientation="Vertical">
                    <CheckBox Content="Place 'X' button on the left"
                              IsChecked="{Binding Launcher.PlaceCloseButtonOnLeft, Mode=TwoWay}" />

                    <CheckBox Content="Close the launcher after executing the client"
                              IsChecked="{Binding Launcher.ExitAfterLaunchingClient, Mode=TwoWay}"
                              IsEnabled="{Binding !Launcher.AllowMultiboxing, Mode=OneWay}" />

                    <CheckBox Content="Check for client updates on launch"
                              IsChecked="{Binding Launcher.CheckForClientUpdatesOnLaunch, Mode=TwoWay}" />

                    <CheckBox Content="Check for updated server profiles on launch"
                              IsChecked="{Binding Launcher.CheckForServerProfilesOnLaunch, Mode=TwoWay}" />

                    <CheckBox Content="Allow multiple client instances to run"
                              IsChecked="{Binding Launcher.AllowMultiboxing, Mode=TwoWay}" />

                    <CheckBox Content="Disable Java2D GPU (noddraw / no GL / no D3D)"
                              IsChecked="{Binding Launcher.DisableJava2dHardwareAccel, Mode=TwoWay}" />

                    <CheckBox Content="Check for launcher updates on launch"
                              IsChecked="{Binding Launcher.CheckForLauncherUpdatesOnLaunch, Mode=TwoWay}" />

                    <!-- OutsideNavigator forces Width=95 — do not use it here -->
                    <Button Margin="0,6,0,8"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="{StaticResource SemiLightMediumBackgroundBrush}"
                            Foreground="{StaticResource LightForegroundBrush}"
                            Command="{Binding CheckLauncherUpdate}"
                            Content="{Binding LauncherUpdateButtonText}" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Margin="2,2,0,0"
                                    Classes="GroupBox"
                                    DockPanel.Dock="Top"
                                    Header="about this project">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource DarkForegroundBrush}"
                               Text="Edited with ❤ by Amilious based on Saradomin" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Foreground="{StaticResource DarkForegroundBrush}"
                                   Text="Made with ❤ by vddCore of " />
                        <Button Classes="Hyperlink"
                                Command="{Binding LaunchScapeWebsite}"
                                Content="2009scape." />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource DarkForegroundBrush}"
                               Text="{Binding VersionString}" />

                    <Button HorizontalAlignment="Center"
                            Classes="Hyperlink"
                            Command="{Binding LaunchProjectWebsite}"
                            Content="visit project website" />
                </StackPanel>
            </HeaderedContentControl>
        </DockPanel>

        <!-- RIGHT -->
        <DockPanel Grid.Column="1">
            <HeaderedContentControl Classes="GroupBox"
                                    DockPanel.Dock="Top"
                                    Header="client settings">
                <StackPanel Margin="0,0,0,4" Spacing="8">

                    <!-- UI scale | FPS | Frame sync -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto">
                        <Grid Grid.Column="0"
                              Margin="0,0,16,0"
                              RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,4,0"
                                       Foreground="{StaticResource DarkForegroundBrush}"
                                       Text="UI scale" />
                            <NumericUpDown Grid.Row="1"
                                           Width="55"
                                           Height="28"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Left"
                                           HorizontalContentAlignment="Right"
                                           AllowSpin="True"
                                           Classes="NormalNumericUpDown"
                                           ClipValueToMinMax="True"
                                           FormatString="0.#"
                                           Increment="0.1"
                                           Maximum="4"
                                           Minimum="0.1"
                                           ShowButtonSpinner="True"
                                           Value="{Binding Client.UiScale, Mode=TwoWay}" />
                        </Grid>

                        <Grid Grid.Column="1"
                              Margin="0,0,16,0"
                              RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,4,0"
                                       Foreground="{StaticResource DarkForegroundBrush}"
                                       Text="Target FPS (0=auto)" />
                            <NumericUpDown Grid.Row="1"
                                           Width="55"
                                           Height="28"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Left"
                                           HorizontalContentAlignment="Right"
                                           AllowSpin="True"
                                           Classes="NormalNumericUpDown"
                                           ClipValueToMinMax="True"
                                           FormatString="0"
                                           Maximum="1000"
                                           Minimum="0"
                                           ShowButtonSpinner="True"
                                           Value="{Binding Client.Fps, Mode=TwoWay}" />
                        </Grid>

                        <Grid Grid.Column="2"
                              RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,4,0"
                                       Foreground="{StaticResource DarkForegroundBrush}"
                                       Text="Frame sync" />
                            <ComboBox Grid.Row="1"
                                      Width="120"
                                      Height="28"
                                      Margin="0,2,0,0"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="{Binding SwapIntervalIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="VSync (1)" />
                                <ComboBoxItem Content="Uncapped (0)" />
                                <ComboBoxItem Content="Adaptive (-1)" />
                            </ComboBox>
                        </Grid>
                    </Grid>

                    <!-- Checkboxes: 2 columns -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto">
                        <CheckBox Grid.Row="0"
                                  Grid.Column="0"
                                  Content="Start fullscreen"
                                  IsChecked="{Binding Client.StartFullscreen, Mode=TwoWay}" />
                        <CheckBox Grid.Row="0"
                                  Grid.Column="1"
                                  Content="Borderless fullscreen"
                                  IsChecked="{Binding Client.BorderlessFullscreen, Mode=TwoWay}" />
                        <CheckBox Grid.Row="1"
                                  Grid.Column="0"
                                  Content="Enable Amilious debug at start"
                                  IsChecked="{Binding Client.EnableAmiliousDebugAtStart, Mode=TwoWay}" />
                    </Grid>

                    <!-- Voiceover / TTS -->
                    <HeaderedContentControl Classes="GroupBox"
                                            Header="voiceover / TTS"
                                            Margin="0,4,0,0">
                        <StackPanel Spacing="6"
                                    Margin="0,0,0,8">

                            <Grid ColumnDefinitions="Auto,*"
                                  Margin="0,2">
                                <TextBlock Grid.Column="0"
                                           Width="110"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource DarkForegroundBrush}"
                                           Text="Provider" />
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding VoiceoverSpeakerIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="OS TTS" />
                                    <ComboBoxItem Content="ElevenLabs" />
                                    <ComboBoxItem Content="OpenAI" />
                                </ComboBox>
                            </Grid>

                            <!-- ElevenLabs -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding IsElevenLabsSelected}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="API key" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.ElevenLabsKey, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="Male voice ID" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.ElevenLabsMale, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="Female voice ID" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.ElevenLabsFemale, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>

                            <!-- OpenAI -->
                            <StackPanel Spacing="4"
                                        IsVisible="{Binding IsOpenAiSelected}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="API key" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.OpenaiKey, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="Model" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.OpenaiModel, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="Male voice" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.OpenaiVoiceMale, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Width="110"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource DarkForegroundBrush}"
                                               Text="Female voice" />
                                    <TextBox Grid.Column="1"
                                             Classes="NormalTextBox"
                                             Height="28"
                                             Text="{Binding Client.OpenaiVoiceFemale, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <Button Margin="0,4,0,0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="{StaticResource SemiLightMediumBackgroundBrush}"
                            Foreground="{StaticResource LightForegroundBrush}"
                            Command="{Binding OpenGameDirectory}"
                            Content="Open folder"
                            ToolTip.Tip="Open AmiliousScape game directory" />
                </StackPanel>
            </HeaderedContentControl>
        </DockPanel>
    </Grid>
</UserControl>